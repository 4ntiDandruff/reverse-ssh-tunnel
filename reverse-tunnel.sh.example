#!/bin/bash
# reverse-tunnel.sh - Buka reverse tunnel ke server perantara dengan auto-reconnect
#
# CARA PAKAI:
# 1. Sesuaikan variabel di bawah
# 2. chmod +x reverse-tunnel.sh
# 3. nohup ./reverse-tunnel.sh > tunnel.log 2>&1 &

# --- KONFIGURASI (sesuaikan) ---
REMOTE_USER="<user-perantara>"
REMOTE_HOST="<ip-atau-host-perantara>"
REMOTE_SSH_PORT="22"
LOCAL_SSHD_PORT="2222"
REMOTE_FORWARD_PORT="2223"
IDENTITY_FILE="$HOME/.ssh/id_ed25519"
# --- AKHIR KONFIGURASI ---

while true; do
  ssh -i "$IDENTITY_FILE" -o IdentitiesOnly=yes \
    -o StrictHostKeyChecking=accept-new \
    -o ConnectTimeout=60 \
    -o BatchMode=yes \
    -o PreferredAuthentications=publickey \
    -o ServerAliveInterval=10 \
    -o ServerAliveCountMax=3 \
    -o ExitOnForwardFailure=yes \
    -N -R "0.0.0.0:${REMOTE_FORWARD_PORT}:127.0.0.1:${LOCAL_SSHD_PORT}" \
    -p "$REMOTE_SSH_PORT" \
    "${REMOTE_USER}@${REMOTE_HOST}"
  echo "$(date): tunnel putus, retry 10 detik..."
  sleep 10
done
